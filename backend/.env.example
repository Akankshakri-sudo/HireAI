APP_NAME=HireAI
APP_VERSION=1.0.0
DEBUG=True

DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/hireai_db

SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated list of allowed CORS origins (frontend URLs)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Maximum resume upload size in megabytes
MAX_UPLOAD_SIZE_MB=5

# Optional: Gemini LLM for interview question generation and resume analysis.
# When GEMINI_API_KEY is empty the app falls back to built-in heuristics.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
AI_TIMEOUT_SECONDS=60
